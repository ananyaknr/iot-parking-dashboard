# Copy using scripts/setup-local.py, which generates strong local credentials.
# Keep the actual .env out of source control and do not paste it into chat.
# Replace with the Windows PC's current trusted LAN IPv4.
MQTT_BIND_IP=172.20.10.12
MQTT_USERNAME=parking
MQTT_PASSWORD=GENERATE_LOCALLY
INFLUX_USERNAME=parking-admin
INFLUX_PASSWORD=GENERATE_LOCALLY
INFLUX_TOKEN=GENERATE_LOCALLY
INFLUX_WRITE_TOKEN=
INFLUX_READ_TOKEN=
GRAFANA_USERNAME=parking-admin
GRAFANA_PASSWORD=GENERATE_LOCALLY
# Set no to open the loopback dashboard without a browser login.
DASHBOARD_AUTH_REQUIRED=yes
