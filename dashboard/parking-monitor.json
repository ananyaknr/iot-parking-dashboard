{
  "uid": "parking-monitor",
  "title": "Intelligence Parking Lot \u2014 Sensor Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "editable": false,
  "tags": [
    "parking",
    "hardware"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "A1 occupancy",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "parking-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "import \"date\"\nfrom(bucket: \"sensor_data\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"parking_node\" and r.kind == \"status\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> map(fn: (r) => ({_time: r._time, _value: if r._time < date.sub(d: 10s, from: now()) then 0 else r.a1_state}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                },
                "2": {
                  "text": "Occupied",
                  "color": "red"
                },
                "3": {
                  "text": "Not installed",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
